# Deriv — API atual REST + WebSocket autenticado por OTP
DERIV_APP_ID=seu_app_id
DERIV_API_TOKEN=pat_com_escopos_read_e_trade
DERIV_ACCOUNT_ID=DOT_SUA_CONTA_DEMO
DERIV_ACCOUNT_TYPE=demo
DERIV_REST_BASE_URL=https://api.derivws.com

# Segurança obrigatória quando DOMAIN estiver preenchido
INTERNAL_API_TOKEN=gere_um_segredo_aleatorio_longo
DASHBOARD_API_KEY=gere_outra_chave_aleatoria_longa
# Permite que o painel salve/inicie robôs REAL; ainda exige confirmação visual.
ALLOW_REAL_TRADING=false
DEV_MODE=false

# Aplicação
DOMAIN=trade.solucoes-nexus.tech
HOST_BIND=127.0.0.1
HOST_PORT=8989
DB_PATH=/app/data/nexus_trader.db
API_BASE_URL=http://nexus-api:8000
BUSINESS_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
EVENT_QUEUE_MAX=2000
RUNTIME_HEARTBEAT_SECONDS=5
MARKET_STALE_AFTER_SECONDS=15
SETTLEMENT_WAIT_TIMEOUT_SECONDS=600
MARKET_HISTORY_RESYNC_SECONDS=30

# Notificações opcionais
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
